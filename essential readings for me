### **Code Implementation: Automatic Density Weighting**

Here is the code to generate these "Smart Weights" for your XGBoost model.

```python
from xgboost import XGBClassifier
from sklearn.model_selection import cross_val_predict, StratifiedKFold
import pandas as pd
import numpy as np

def get_density_weights(train_df, test_df):
    # 1. Prepare Adversarial Data
    train = train_df.copy()
    test = test_df.copy()
    
    # Drop target and IDs
    if 'diagnosed_diabetes' in train.columns:
        train = train.drop('diagnosed_diabetes', axis=1)
    
    # Label: 0 = Train, 1 = Test
    X = pd.concat([train, test])
    y = np.array([0] * len(train) + [1] * len(test))
    
    # 2. Train Adversarial Classifier
    # We use a simple XGB to distinguish Train vs Test
    model = XGBClassifier(n_estimators=100, max_depth=4, random_state=42)
    
    # Get probabilities for the ENTIRE dataset (Train + Test)
    # cross_val_predict ensures we don't overfit to the fold we are predicting
    cv = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)
    preds = cross_val_predict(model, X, y, cv=cv, method='predict_proba')[:, 1]
    
    # 3. Calculate Weights for TRAIN set only
    # Extract preds for the training rows
    train_probs = preds[:len(train)]
    
    # Formula: w = p / (1 - p)
    # Clip probabilities to avoid division by zero (e.g., max 0.99)
    train_probs = np.clip(train_probs, 0.01, 0.99)
    weights = train_probs / (1 - train_probs)
    
    # Normalize weights so mean = 1.0 (optional, keeps learning rate stable)
    weights = weights / weights.mean()
    
    return weights

# --- Usage ---
sample_weights = get_density_weights(train, test)

# Now train your REAL model with these weights
final_model = XGBClassifier()
final_model.fit(X_train, y_train, sample_weight=sample_weights)
```

