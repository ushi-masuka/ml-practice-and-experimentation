    "# ==============================================================================\n",
    "# 🏆 DIABETES PREDICTION: ROBUST BASELINE (WEIGHTED + MULTI-VIEW + ID SIGNAL)\n",
    "# ==============================================================================\n",
    "\n",
    "# 📦 0. INSTALL MISSING LIBRARY (Run this line first!)\n",
    "# !pip install category_encoders\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import lightgbm as lgb\n",
    "from sklearn.model_selection import StratifiedKFold, cross_val_predict\n",
    "from sklearn.metrics import roc_auc_score\n",
    "from category_encoders import TargetEncoder\n",
    "import warnings\n",
    "\n",
    "# Settings\n",
    "warnings.filterwarnings('ignore')\n",
    "SEED = 42\n",
    "FOLDS = 5\n",
    "\n",
    "# ==============================================================================\n",
    "# 1. SETUP & DATA LOADING\n",
    "# ==============================================================================\n",
    "print(\"📥 Loading Data...\")\n",
    "train = pd.read_csv('/kaggle/input/playground-series-s5e12/train.csv')\n",
    "test = pd.read_csv('/kaggle/input/playground-series-s5e12/test.csv')\n",
    "\n",
    "# 🚨 CRITICAL: Sort by ID to align with the hidden time dimension\n",
    "# We reset index so StratifiedKFold works correctly with the weights later\n",
    "train = train.sort_values('id').reset_index(drop=True)\n",
    "\n",
    "# Separate Target\n",
    "target = 'diagnosed_diabetes'\n",
    "original_features = [c for c in train.columns if c not in ['id', target]]\n",
    "\n",
    "print(f\"✅ Data Loaded. Train: {train.shape}, Test: {test.shape}\")\n",
    "\n",
    "# ==============================================================================\n",
    "# 2. ADVERSARIAL WEIGHTING (The \"Smart\" Weights)\n",
    "# ==============================================================================\n",
    "def get_density_weights(train_df, test_df, features):\n",
    "    \"\"\"\n",
    "    Calculates sample_weights for training data based on how much \n",
    "    a row resembles the Test set using a Density Ratio estimation.\n",
    "    \"\"\"\n",
    "    print(\"\\n⚖️ Calculating Adversarial Weights...\")\n",
    "    \n",
    "    # Label: 0 = Train, 1 = Test\n",
    "    X_train = train_df[features].copy()\n",
    "    X_test = test_df[features].copy()\n",
    "    X_train['is_test'] = 0\n",
    "    X_test['is_test'] = 1\n",
    "    \n",
    "    # Combine\n",
    "    X_adv = pd.concat([X_train, X_test], axis=0).reset_index(drop=True)\n",
    "    y_adv = X_adv.pop('is_test')\n",
    "    \n",
    "    # Convert object cols to category for LightGBM efficiency\n",
    "    for col in X_adv.select_dtypes(include=['object']).columns:\n",
    "        X_adv[col] = X_adv[col].astype('category')\n",
    "        \n",
    "    model = lgb.LGBMClassifier(n_estimators=100, random_state=SEED, verbose=-1)\n",
    "    \n",
    "    # Get probabilities for the Train set using CV (to avoid overfitting)\n",
    "    train_preds = cross_val_predict(model, X_adv.iloc[:len(train_df)], y_adv.iloc[:len(train_df)], \n",
    "                                    cv=5, method='predict_proba')[:, 1]\n",
    "    \n",
    "    # Calculate Weights: w = p / (1 - p)\n",
    "    # Clip probabilities to avoid infinity (max 0.95 ensures max weight is ~19.0)\n",
    "    train_probs = np.clip(train_preds, 0.01, 0.95)\n",
    "    weights = train_probs / (1 - train_probs)\n",
    "    \n",
    "    # Normalize weights so they sum to the original length\n",
    "    weights = weights * (len(train_df) / weights.sum())\n",
    "    \n",
    "    print(f\"   -> Max Weight: {weights.max():.2f} (Rows identical to Test)\")\n",
    "    print(f\"   -> Min Weight: {weights.min():.2f} (Rows different from Test)\")\n",
    "    \n",
    "    return weights\n",
    "\n",
    "# Generate the weights\n",
    "sample_weights = get_density_weights(train, test, original_features)\n",
    "\n",
    "# ==============================================================================\n",
    "# 3. FEATURE ENGINEERING (Bio + Multi-View)\n",
    "# ==============================================================================\n",
    "def engineer_features(df):\n",
    "    df = df.copy()\n",
    "    \n",
    "    # --- A. Biological Interactions ---\n",
    "    # 1. Lipid Ratios (Heart Health)\n",
    "    # Log transform handles the skew in triglycerides\n",
    "    df['atherogenic_index'] = np.log1p(df['triglycerides']) - np.log1p(df['hdl_cholesterol'])\n",
    "    df['non_hdl'] = df['cholesterol_total'] - df['hdl_cholesterol']\n",
    "    \n",
    "    # 2. Blood Pressure\n",
    "    df['pulse_pressure'] = df['systolic_bp'] - df['diastolic_bp']\n",
    "    \n",
    "    # 3. Risk Multipliers\n",
    "    # Normalize BMI to make the interaction cleaner\n",
    "    bmi_norm = (df['bmi'] - 25) / 5\n",
    "    df['genetic_risk'] = df['family_history_diabetes'] * bmi_norm\n",
    "    \n",
    "    return df\n",
    "\n",
    "def create_multiview_bins(df, cols):\n",
    "    \"\"\" Creates Quantile (Rank) and Log-Uniform (Magnitude) bins. \"\"\"\n",
    "    df_out = df.copy()\n",
    "    for col in cols:\n",
    "        # Quantile: Fixes drift (Rank matters, not value)\n",
    "        df_out[f'{col}_q10'] = pd.qcut(df_out[col], q=10, labels=False, duplicates='drop')\n",
    "        \n",
    "        # Log-Uniform: Captures magnitude differences (useful for skewed cols)\n",
    "        if df_out[col].min() >= 0:\n",
    "            df_out[f'{col}_log10'] = pd.cut(np.log1p(df_out[col]), bins=10, labels=False, duplicates='drop')\n",
    "            \n",
    "    return df_out\n",
    "\n",
    "print(\"\\n🛠️ Engineering Features...\")\n",
    "# 1. Apply Bio Engineering\n",
    "train_eng = engineer_features(train)\n",
    "test_eng = engineer_features(test)\n",
    "\n",
    "# 2. Apply Multi-View Binning\n",
    "cols_to_bin = ['age', 'bmi', 'physical_activity_minutes_per_week', 'triglycerides']\n",
    "train_binned = create_multiview_bins(train_eng, cols_to_bin)\n",
    "test_binned = create_multiview_bins(test_eng, cols_to_bin)\n",
    "\n",
    "# Identify Binned Columns for Encoding\n",
    "bin_cols = [c for c in train_binned.columns if '_q10' in c or '_log10' in c]\n",
    "print(f\"   -> Created {len(bin_cols)} binned features for Multi-View Encoding.\")\n",
    "\n",
    "# Drop Target from Feature Matrix\n",
    "X = train_binned.drop([target], axis=1) # KEEP 'id', drop 'target'\n",
    "y = train[target]\n",
    "X_test = test_binned # Test doesn't have target\n",
    "\n",
    "# Ensure Categoricals are properly typed for LGBM\n",
    "cat_cols = X.select_dtypes(include=['object']).columns.tolist()\n",
    "for c in cat_cols:\n",
    "    X[c] = X[c].astype('category')\n",
    "    X_test[c] = X_test[c].astype('category')\n",
    "\n",
    "print(f\"✅ Final Feature Count: {X.shape[1]}\")\n",
    "\n",
    "# ==============================================================================\n",
    "# 4. MODEL TRAINING (Weighted Refit + Internal Encoding)\n",
    "# ==============================================================================\n",
    "print(\"\\n🚀 Starting Training (LightGBM)...\")\n",
    "\n",
    "skf = StratifiedKFold(n_splits=FOLDS, shuffle=True, random_state=SEED)\n",
    "oof_preds = np.zeros(len(X))\n",
    "test_preds = np.zeros(len(X_test))\n",
    "\n",
    "for fold, (train_idx, val_idx) in enumerate(skf.split(X, y)):\n",
    "    # 1. Split Data\n",
    "    X_tr, y_tr = X.iloc[train_idx].copy(), y.iloc[train_idx]\n",
    "    X_val, y_val = X.iloc[val_idx].copy(), y.iloc[val_idx]\n",
    "    \n",
    "    # 2. Get Weights (Only for training set)\n",
    "    w_tr = sample_weights[train_idx]\n",
    "    \n",
    "    # 3. Target Encoding (INSIDE LOOP to prevent Leakage)\n",
    "    # We fit on X_tr, and transform both X_tr and X_val\n",
    "    encoder = TargetEncoder(cols=bin_cols, smoothing=20)\n",
    "    X_tr[bin_cols] = encoder.fit_transform(X_tr[bin_cols], y_tr)\n",
    "    X_val[bin_cols] = encoder.transform(X_val[bin_cols])\n",
    "    \n",
    "    # Encode Test Set (Averaged over folds)\n",
    "    X_test_fold = X_test.copy()\n",
    "    X_test_fold[bin_cols] = encoder.transform(X_test_fold[bin_cols])\n",
    "    \n",
    "    # 4. Define Model\n",
    "    model = lgb.LGBMClassifier(\n",
    "        n_estimators=3000,\n",
    "        learning_rate=0.01,       # Slower rate for better convergence\n",
    "        max_depth=8,              # Prevent deep overfitting\n",
    "        num_leaves=64,\n",
    "        colsample_bytree=0.5,     # \"Crowding Out\" protection (Use 50% cols per tree)\n",
    "        subsample=0.8,\n",
    "        reg_lambda=1.5,           # L2 Regularization\n",
    "        random_state=SEED,\n",
    "        verbose=-1\n",
    "    )\n",
    "    \n",
    "    # 5. Train with Smart Weights\n",
    "    model.fit(\n",
    "        X_tr, y_tr,\n",
    "        sample_weight=w_tr,\n",
    "        eval_set=[(X_val, y_val)],\n",
    "        eval_metric='auc',\n",
    "        callbacks=[lgb.early_stopping(100, verbose=False)]\n",
    "    )\n",
    "    \n",
    "    # 6. Predict\n",
    "    val_pred = model.predict_proba(X_val)[:, 1]\n",
    "    oof_preds[val_idx] = val_pred\n",
    "    \n",
    "    # Accumulate Test Predictions\n",
    "    test_preds += model.predict_proba(X_test_fold)[:, 1] / FOLDS\n",
    "    \n",
    "    score = roc_auc_score(y_val, val_pred)\n",
    "    print(f\"   Fold {fold+1}: AUC = {score:.5f}\")\n",
    "\n",
    "print(f\"\\n🏆 Overall CV AUC: {roc_auc_score(y, oof_preds):.5f}\")\n",
    "\n",
    "# ==============================================================================\n",
    "# 5. SUBMISSION & TAIL CHECK\n",
    "# ==============================================================================\n",
    "# Check the Tail Score (Last 5% of training data) - The best proxy for LB\n",
    "tail_cutoff = int(len(train) * 0.95)\n",
    "tail_y = y.iloc[tail_cutoff:]\n",
    "tail_pred = oof_preds[tail_cutoff:]\n",
    "print(f\"🔍 Tail (Last 5%) AUC: {roc_auc_score(tail_y, tail_pred):.5f} (Expect LB to be close to this)\")\n",
    "\n",
    "submission = pd.DataFrame({'id': test['id'], 'diagnosed_diabetes': test_preds})\n",
    "submission.to_csv('submission.csv', index=False)\n",
    "print(\"✅ submission.csv saved!\")"
   ]
  }
