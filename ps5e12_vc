{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"pygments_lexer":"ipython3","nbconvert_exporter":"python","version":"3.6.4","file_extension":".py","codemirror_mode":{"name":"ipython","version":3},"name":"python","mimetype":"text/x-python"},"kaggle":{"accelerator":"none","dataSources":[{"sourceId":91723,"databundleVersionId":14272474,"sourceType":"competition"}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"# this is a vibe coded notebook made after going through all the discussions\n\n# ==============================================================================\n# 🏆 DIABETES PREDICTION: ROBUST BASELINE (WEIGHTED + MULTI-VIEW)\n# ==============================================================================\n# Strategy:\n# 1. Sort by ID: Exploits the \"Time Drift\" leak in the dataset.\n# 2. Adversarial Weights: Assigns high importance to rows that look like the Test set.\n# 3. Biological FE: Adds medical interactions (Lipid Ratios, BP Pulse).\n# 4. Multi-View Binning: Creates Rank/Distance/Skew views for Target Encoding.\n# 5. Model: LightGBM trained with density-based sample weights.\n# ==============================================================================\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport lightgbm as lgb\nfrom sklearn.model_selection import StratifiedKFold, cross_val_predict\nfrom sklearn.metrics import roc_auc_score\nfrom xgboost import XGBClassifier\nfrom category_encoders import TargetEncoder\nimport warnings\n\n# Settings\nwarnings.filterwarnings('ignore')\nSEED = 42\nFOLDS = 5\n\n# ==============================================================================\n# 1. SETUP & DATA LOADING\n# ==============================================================================\nprint(\"📥 Loading Data...\")\ntrain = pd.read_csv('/kaggle/input/playground-series-s5e12/train.csv')\ntest = pd.read_csv('/kaggle/input/playground-series-s5e12/test.csv')\nsample_sub = pd.read_csv('/kaggle/input/playground-series-s5e12/sample_submission.csv')\n\n# 🚨 CRITICAL: Sort by ID to align with the hidden time dimension\ntrain = train.sort_values('id').reset_index(drop=True)\n\n# Separate Target\ntarget = 'diagnosed_diabetes'\noriginal_features = [c for c in train.columns if c not in ['id', target]]\n\nprint(f\"✅ Data Loaded. Train: {train.shape}, Test: {test.shape}\")\n\n# ==============================================================================\n# 2. ADVERSARIAL WEIGHTING (The \"Smart\" Weights)\n# ==============================================================================\ndef get_density_weights(train_df, test_df, features):\n    \"\"\"\n    Calculates sample_weights for training data based on how much \n    a row resembles the Test set.\n    \"\"\"\n    print(\"\\n⚖️ Calculating Adversarial Weights...\")\n    \n    # Label: 0 = Train, 1 = Test\n    X_train = train_df[features].copy()\n    X_test = test_df[features].copy()\n    X_train['is_test'] = 0\n    X_test['is_test'] = 1\n    \n    # Combine\n    X_adv = pd.concat([X_train, X_test], axis=0).reset_index(drop=True)\n    y_adv = X_adv.pop('is_test')\n    \n    # Simple Model to distinguish Train vs Test\n    # We use Categorical support for simple encoding\n    for col in X_adv.select_dtypes(include=['object']).columns:\n        X_adv[col] = X_adv[col].astype('category')\n        \n    model = lgb.LGBMClassifier(n_estimators=100, random_state=SEED, verbose=-1)\n    \n    # Get probabilities for the Train set using CV (to avoid overfitting)\n    # We only care about predictions for the '0' (Train) part\n    train_preds = cross_val_predict(model, X_adv.iloc[:len(train_df)], y_adv.iloc[:len(train_df)], \n                                    cv=5, method='predict_proba')[:, 1]\n    \n    # Calculate Weights: w = p / (1 - p)\n    # Clip probabilities to avoid infinity\n    train_probs = np.clip(train_preds, 0.01, 0.95)\n    weights = train_probs / (1 - train_probs)\n    \n    # Normalize weights so they sum to the original length (keeps learning rate stable)\n    weights = weights * (len(train_df) / weights.sum())\n    \n    print(f\"   -> Max Weight: {weights.max():.2f} (This row looks identical to Test)\")\n    print(f\"   -> Min Weight: {weights.min():.2f} (This row looks nothing like Test)\")\n    \n    return weights\n\n# Generate the weights\nsample_weights = get_density_weights(train, test, original_features)\n\n# ==============================================================================\n# 3. FEATURE ENGINEERING (Bio + Multi-View)\n# ==============================================================================\ndef engineer_features(df):\n    df = df.copy()\n    \n    # --- A. Biological Interactions (The \"Doctors\" Cluster) ---\n    # 1. Lipid Ratios (Heart Health)\n    # Log transform handles the skew in triglycerides\n    df['atherogenic_index'] = np.log1p(df['triglycerides']) - np.log1p(df['hdl_cholesterol'])\n    df['non_hdl'] = df['cholesterol_total'] - df['hdl_cholesterol']\n    \n    # 2. Blood Pressure\n    df['pulse_pressure'] = df['systolic_bp'] - df['diastolic_bp']\n    \n    # 3. Risk Multipliers\n    # Normalize BMI to make the interaction cleaner\n    bmi_norm = (df['bmi'] - 25) / 5\n    df['genetic_risk'] = df['family_history_diabetes'] * bmi_norm\n    \n    return df\n\ndef create_multiview_bins(df, cols):\n    \"\"\"\n    Creates Quantile (Rank), Uniform (Distance), and Log (Magnitude) bins.\n    \"\"\"\n    df_out = df.copy()\n    for col in cols:\n        # Quantile: Fixes drift (Rank matters, not value)\n        df_out[f'{col}_q10'] = pd.qcut(df_out[col], q=10, labels=False, duplicates='drop')\n        \n        # Log-Uniform: Captures magnitude differences\n        # useful for skewed cols like triglycerides\n        if df_out[col].min() >= 0:\n            df_out[f'{col}_log10'] = pd.cut(np.log1p(df_out[col]), bins=10, labels=False, duplicates='drop')\n            \n    return df_out\n\nprint(\"\\n🛠️ Engineering Features...\")\n# 1. Apply Bio Engineering\ntrain_eng = engineer_features(train)\ntest_eng = engineer_features(test)\n\n# 2. Apply Multi-View Binning\ncols_to_bin = ['age', 'bmi', 'physical_activity_minutes_per_week', 'triglycerides']\ntrain_binned = create_multiview_bins(train_eng, cols_to_bin)\ntest_binned = create_multiview_bins(test_eng, cols_to_bin)\n\n# 3. Target Encoding the Bins\n# Note: We must encode continuous bins to give the tree \"shortcuts\"\nbin_cols = [c for c in train_binned.columns if '_q10' in c or '_log10' in c]\nprint(f\"   -> Target Encoding {len(bin_cols)} binned features...\")\n\n# IMPORTANT: High smoothing prevents overfitting to small bins\nencoder = TargetEncoder(cols=bin_cols, smoothing=20)\ntrain_encoded = encoder.fit_transform(train_binned, train[target])\ntest_encoded = encoder.transform(test_binned)\n\n# Final Feature Set\nX = train_encoded.drop(['id', target], axis=1)\ny = train[target]\nX_test = test_encoded.drop(['id'], axis=1)\n\n# Ensure Categoricals are properly typed for LGBM\ncat_cols = X.select_dtypes(include=['object']).columns.tolist()\nfor c in cat_cols:\n    X[c] = X[c].astype('category')\n    X_test[c] = X_test[c].astype('category')\n\nprint(f\"✅ Final Features: {X.shape[1]}\")\n\n# ==============================================================================\n# 4. MODEL TRAINING (Weighted Refit)\n# ==============================================================================\nprint(\"\\n🚀 Starting Training (LightGBM)...\")\n\nskf = StratifiedKFold(n_splits=FOLDS, shuffle=True, random_state=SEED)\noof_preds = np.zeros(len(X))\ntest_preds = np.zeros(len(X_test))\nmodels = []\n\nfor fold, (train_idx, val_idx) in enumerate(skf.split(X, y)):\n    X_tr, y_tr = X.iloc[train_idx], y.iloc[train_idx]\n    X_val, y_val = X.iloc[val_idx], y.iloc[val_idx]\n    \n    # Get weights for this fold's training data\n    w_tr = sample_weights[train_idx]\n    \n    model = lgb.LGBMClassifier(\n        n_estimators=2000,\n        learning_rate=0.015,\n        max_depth=8,              # Prevent deep overfitting\n        num_leaves=64,\n        colsample_bytree=0.5,     # \"Crowding Out\" protection (Use 50% cols per tree)\n        subsample=0.8,\n        reg_lambda=1.5,           # L2 Regularization\n        random_state=SEED,\n        verbose=-1\n    )\n    \n    # TRAIN WITH WEIGHTS\n    # This forces the model to prioritize \"Test-like\" rows\n    model.fit(\n        X_tr, y_tr,\n        sample_weight=w_tr,\n        eval_set=[(X_val, y_val)],\n        eval_metric='auc',\n        callbacks=[lgb.early_stopping(100, verbose=False)]\n    )\n    \n    # Predict\n    val_pred = model.predict_proba(X_val)[:, 1]\n    oof_preds[val_idx] = val_pred\n    test_preds += model.predict_proba(X_test)[:, 1] / FOLDS\n    \n    score = roc_auc_score(y_val, val_pred)\n    print(f\"   Fold {fold+1}: AUC = {score:.5f}\")\n    models.append(model)\n\nprint(f\"\\n🏆 Overall CV AUC: {roc_auc_score(y, oof_preds):.5f}\")\n\n# ==============================================================================\n# 5. SUBMISSION\n# ==============================================================================\n# Check the Tail Score (Last 5% of training data) - The best proxy for LB\ntail_cutoff = int(len(train) * 0.95)\ntail_y = y.iloc[tail_cutoff:]\ntail_pred = oof_preds[tail_cutoff:]\nprint(f\"🔍 Tail (Last 5%) AUC: {roc_auc_score(tail_y, tail_pred):.5f} (Expect LB to be close to this)\")\n\nsubmission = pd.DataFrame({'id': test['id'], 'diagnosed_diabetes': test_preds})\nsubmission.to_csv('submission.csv', index=False)\nprint(\"✅ submission.csv saved!\")","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb907d3b93b6e0e5","_cell_guid":"b1076dfc-b9ad-4769-8c92-a6c4dae69d19","trusted":true},"outputs":[],"execution_count":null}]}